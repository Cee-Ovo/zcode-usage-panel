# dependencies / build caches
node_modules
dist
src-tauri/target
src-tauri/gen
.vite
coverage

# local artifacts & release output (builds produce into dist/releases)
*.log
logs
portable
.DS_Store

# runtime user data never belongs in the repo
*.sqlite
*.sqlite-wal
*.sqlite-shm
