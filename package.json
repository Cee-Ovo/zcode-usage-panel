{
  "name": "zcode-usage-panel",
  "private": true,
  "version": "1.1.0",
  "description": "Real-time ZCode Harness token usage monitor - desktop panel, tray and edge-docking mini window.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icon": "node scripts/gen-icon.mjs && npx tauri icon src-tauri/icons/source.png",
    "tauri": "tauri"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "open-glass-ui": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "~5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
