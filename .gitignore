codex-usage-cache.json
quota-history.sqlite
alert-memory.json
settings.json

# credentials & secrets — must never be committed
# (patterns are deliberately narrow: never blanket-match source files)
*.pem
*.token
.env
.env.*
credentials.json
client_secret*.json
