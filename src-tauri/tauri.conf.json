{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZCode Usage Panel",
  "version": "1.0.0",
  "identifier": "com.zcode.usagepanel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZCode Usage Panel",
        "width": 980,
        "height": 700,
        "minWidth": 400,
        "minHeight": 540,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "ZCode token usage monitor",
    "longDescription": "Real-time monitor for local ZCode Harness model token consumption: dashboard, tray popup, QQ-style edge docking.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 ZCode Usage Panel contributors (MIT)",
    "publisher": "ZCode Usage Panel",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
